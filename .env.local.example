# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para Organizer.
# Copia este archivo a `.env.local` (local) o cárgalas en Vercel (producción).
# NUNCA subas el archivo .env.local real al repo: contiene secretos.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (base de datos + login) ---
# Las encuentras en tu proyecto Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- GitHub (lectura del estado de tus repos) ---
# Token FINO de solo lectura: GitHub → Settings → Developer settings →
# Fine-grained tokens. Permisos de solo lectura: Contents, Metadata, Issues,
# Pull requests. Vive SOLO en el servidor (no lleva NEXT_PUBLIC_).
GITHUB_TOKEN=github_pat_xxx

# --- OpenAI (resumen del estado + siguiente acción sugerida) ---
# Tu API key de OpenAI. Vive SOLO en el servidor.
OPENAI_API_KEY=sk-xxx
# Modelo económico para los resúmenes (opcional; por defecto gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
