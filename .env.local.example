# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para Faro.
# Copia a `.env.local` (local) o cárgalas en Vercel (producción).
# NUNCA subas el archivo .env.local real: contiene secretos.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (base de datos + login OAuth) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Google (login + Google Drive) ---
# Se crean en Google Cloud Console (OAuth Client). El client_secret se usa en el
# servidor para refrescar el token de Drive. El mismo client id/secret se pega
# también en Supabase → Authentication → Providers → Google.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# --- OpenAI (resumen / análisis) ---
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# --- Re-análisis programado (cron de Vercel) — OPCIONAL ---
# Necesarias solo si quieres el re-análisis automático diario.
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API → service_role (secreto).
# CRON_SECRET: una cadena aleatoria; Vercel la envía como Bearer al cron para autenticarlo.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
CRON_SECRET=una-cadena-larga-aleatoria

# --- GitHub (OPCIONAL / legado) ---
# Ya NO es necesario: el acceso a repos se hace con "Conectar GitHub" (OAuth) en
# la app. Se deja como respaldo opcional. El client id/secret de la GitHub OAuth
# App se pegan en Supabase → Authentication → Providers → GitHub.
# GITHUB_TOKEN=github_pat_xxx
